# ==============================================================================
# dbshift Environment Configuration Template
# Copy this file to .env and replace placeholder values with your actual URIs.
# ==============================================================================

# Database Engine: postgres or mongo
DB_ENGINE=postgres

# ------------------------------------------------------------------------------
# Example URIs for CockroachDB Cloud / PostgreSQL / Neon / Supabase:
# ------------------------------------------------------------------------------
SOURCE_URI="postgresql://username:password@source-cluster.cockroachlabs.cloud:26257/dbname?sslmode=verify-full"
TARGET_URI="postgresql://username:password@target-cluster.cockroachlabs.cloud:26257/dbname?sslmode=verify-full"

# ------------------------------------------------------------------------------
# Example URIs for MongoDB Atlas:
# ------------------------------------------------------------------------------
# SOURCE_URI="mongodb+srv://username:password@source-cluster.mongodb.net/dbname?retryWrites=true&w=majority"
# TARGET_URI="mongodb+srv://username:password@target-cluster.mongodb.net/dbname?retryWrites=true&w=majority"

# ------------------------------------------------------------------------------
# Performance & Worker Configuration:
# ------------------------------------------------------------------------------
# Number of parallel workers for concurrent table copying (default: 4)
CONCURRENCY=4

# Streaming chunk size in rows per batch (default: 2500)
BATCH_SIZE=2500